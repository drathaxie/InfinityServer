# ─── InfinityServer production DB / runtime env (Postgres backend) ──────────
# Copy this file to `server/.pg.env` (which is GITIGNORED) and fill in real values.
# Source it before running any server script:
#     cd server && set -a && . ./.pg.env && set +a && python server.py
#
# The REAL production values live ONLY on the VM at /opt/infinity/server/.pg.env
# and are shared out-of-band by the maintainer — never commit them or paste them in chat.
#
# For LOCAL DEVELOPMENT you do NOT need this file at all: with INFINITY_DB unset the
# server defaults to a local SQLite database (zero config). See README "Run it locally".

# Select the Postgres backend (omit entirely / set to "sqlite" for local dev).
INFINITY_DB=postgres

# Postgres connection (the DB listens on the VM's localhost only).
INFINITY_PG_HOST=127.0.0.1
INFINITY_PG_PORT=5432
INFINITY_PG_DB=infinity
INFINITY_PG_USER=infinity
INFINITY_PG_PASSWORD=          # <-- real value from the maintainer; do not commit

# Public host advertised to clients in the server list (sIP). Usually the VM's
# hostname/IP or the Caddy domain. Optional; defaults are derived in webapi.py.
INFINITY_PUBLIC_HOST=

# Optional overrides (defaults are sane):
# INFINITY_GAME_PORT=5588      # TCP game server port
