# Cloudflare R2 write credentials for r2_sync.py.
# Copy this file to `.r2.env` (which is gitignored) and fill in the four values from a
# Cloudflare R2 API token (R2 -> Manage R2 API Tokens -> Object Read & Write, scoped to the
# bucket). NEVER commit the real .r2.env or paste the secret into chat.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
