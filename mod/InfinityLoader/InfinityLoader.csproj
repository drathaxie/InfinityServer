<Project Sdk="Microsoft.NET.Sdk">
  <!--
    InfinityLoader — our OWN minimal client mod, self-contained in InfinityServer (no
    dependency on the external Beyond project, and no MelonLoader).

    AE:I ships its own HarmonyLib (0Harmony 2.4.2.0) in Managed/ and that collides with
    MelonLoader's bootstrap Harmony — which is why MelonLoader can't load on this build.
    So instead of MelonLoader we inject via Unity Doorstop and patch with AE's OWN Harmony.

    Doorstop calls `Doorstop.Entrypoint.Start()` at process start; we apply a few Harmony
    patches there: redirect Main.WebApiURL -> our local web API (so login + the server list
    come from us), and re-add the always-on c2s/s2c packet logger (our capture ground truth).
  -->
  <PropertyGroup>
    <AssemblyName>InfinityLoader</AssemblyName>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Silence assembly-version conflict noise (Mono resolves against its own copies). -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <PropertyGroup>
    <AqwiGameDir Condition="'$(AQWI_GAME_DIR)' != ''">$(AQWI_GAME_DIR)</AqwiGameDir>
    <AqwiGameDir Condition="'$(AqwiGameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\AdventureQuest Worlds Unity Playtest</AqwiGameDir>
    <AqwiManaged>$(AqwiGameDir)\AdventureQuest Worlds Infinity_Data\Managed</AqwiManaged>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\StatuePedestal.png" LogicalName="InfinityLoader.StatuePedestal.png" />

    <Reference Include="Assembly-CSharp">
      <HintPath>$(AqwiManaged)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <!-- AE's OWN Harmony (2.4.2.0) — the same instance the game has loaded, so no conflict.
           The base game ships NO 0Harmony in Managed/; our Doorstop pack supplies it, so build
           against the repo's bundled copy (mod/doorstop/0Harmony.dll). -->
      <HintPath>$(MSBuildProjectDirectory)\..\doorstop\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(AqwiManaged)\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <!-- AEC is a Singleton<MonoBehaviour>, so its type graph pulls in UnityEngine. -->
      <HintPath>$(AqwiManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <!-- AssetBundle.LoadFromFile for the chat-emoji TMP sprite-asset bundle. -->
      <HintPath>$(AqwiManaged)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <!-- Animator/runtimeAnimatorController inspection for the NPC baker runtime capture. -->
      <HintPath>$(AqwiManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <!-- AudioClip/MixerTrack.Clip inspection for the cutscene editor's sfx cue picker. -->
      <HintPath>$(AqwiManaged)\UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <!-- Texture2D.LoadImage(byte[]) to build custom portrait-frame sprites from PNGs. -->
      <HintPath>$(AqwiManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <!-- TMP_SpriteAsset / TMP_Settings / TMP_Text for chat emoji. -->
      <HintPath>$(AqwiManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <!-- Canvas/RenderMode for the NPC baker click blocker overlay. -->
      <HintPath>$(AqwiManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <!-- TMP_Text : MaskableGraphic (UnityEngine.UI) — needed to touch UIChat.textField. -->
      <HintPath>$(AqwiManaged)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(AqwiManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <!-- Collider2D cleanup for NPC baker preview/capture objects. -->
      <HintPath>$(AqwiManaged)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <!-- TEMPORARY: ParticleSystem.isEmitting inspection for the sky-blade diagnostics
           (ParticleDiagnostics.cs). Drop together with that file. -->
      <HintPath>$(AqwiManaged)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <!-- OnGUI / GUILayout — the in-client cutscene editor's immediate-mode panel (CutsceneEditor.cs). -->
      <HintPath>$(AqwiManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <!-- Input.GetKeyDown for the editor's toggle hotkey (the game uses legacy Input, e.g. Dialogger_Manager.Update). -->
      <HintPath>$(AqwiManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <!-- TextAnchor / FontStyle for the editor's GUIStyle theming (CutsceneEditor.cs). -->
      <HintPath>$(AqwiManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
